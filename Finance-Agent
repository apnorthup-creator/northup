-- ============================================================
-- TABLES
-- ============================================================

CREATE TABLE accounts (
    id              SERIAL PRIMARY KEY,
    nickname        TEXT NOT NULL UNIQUE,
    institution     TEXT NOT NULL,
    last4           CHAR(4) NOT NULL,
    account_type    TEXT NOT NULL CHECK (account_type IN ('checking', 'savings', 'credit')),
    role            TEXT,                       -- human description of what the account is for
    is_active       BOOLEAN NOT NULL DEFAULT TRUE,
    opening_balance NUMERIC(12,2) NOT NULL,     -- negative for credit card balances owed
    reserved_amount NUMERIC(12,2) NOT NULL DEFAULT 0,  -- earmarked money (e.g. $8,100 medical reserve in Bills); projection flags dips below this
    opening_date    DATE NOT NULL,
    notes           TEXT
);

CREATE TABLE categories (
    id      SERIAL PRIMARY KEY,
    grp     TEXT NOT NULL,      -- EveryDollar group: Income, Disposable, Bills/Subscriptions, Southwest CC, Marriott CC, Savings, SWDeb
    name    TEXT NOT NULL,      -- budget line item: Mortgage, Groceries, AT&T...
    UNIQUE (grp, name)
);

CREATE TABLE category_budgets (
    id                SERIAL PRIMARY KEY,
    budget_period_id  INT NOT NULL REFERENCES budget_periods(id),
    category_id       INT NOT NULL REFERENCES categories(id),
    planned           NUMERIC(12,2) NOT NULL,
    UNIQUE (budget_period_id, category_id)
);

CREATE TABLE coding_rules (
    id          SERIAL PRIMARY KEY,
    pattern     TEXT NOT NULL,              -- case-insensitive substring matched against transaction description
    category_id INT NOT NULL REFERENCES categories(id),
    priority    INT NOT NULL DEFAULT 100,   -- lower wins when multiple patterns match
    created_from TEXT DEFAULT 'manual'      -- 'manual' | 'claude' | 'correction'
);

CREATE TABLE budget_periods (
    id               SERIAL PRIMARY KEY,
    start_date       DATE NOT NULL UNIQUE,      -- always the 15th
    end_date         DATE NOT NULL,             -- the following 14th
    variable_budget  NUMERIC(12,2),             -- Alex sets this; NULL until decided
    notes            TEXT
);

CREATE TABLE recurring_items (
    id              SERIAL PRIMARY KEY,
    name            TEXT NOT NULL,
    account_id      INT NOT NULL REFERENCES accounts(id),
    direction       TEXT NOT NULL CHECK (direction IN ('inflow', 'outflow', 'transfer')),
    transfer_to_id  INT REFERENCES accounts(id),        -- set only when direction = 'transfer'
    amount          NUMERIC(12,2) NOT NULL,             -- positive; direction carries the sign
    pay_full_balance BOOLEAN NOT NULL DEFAULT FALSE,    -- transfer clears target card's balance that day; amount ignored
    amount_is_estimate BOOLEAN NOT NULL DEFAULT FALSE,  -- true for variable items like dog daycare
    frequency       TEXT NOT NULL CHECK (frequency IN
                        ('weekly', 'biweekly', 'semimonthly', 'monthly', 'quarterly', 'weekdays', 'once')),
    anchor_date     DATE,                       -- first/known occurrence; projection walks forward from here
    day_of_month    INT CHECK (day_of_month BETWEEN 1 AND 31),  -- for monthly items with a fixed day
    weekday         INT CHECK (weekday BETWEEN 0 AND 6),        -- 0=Sunday, for weekly items
    start_date      DATE,                       -- item not projected before this
    end_date        DATE,                       -- item not projected after this (e.g. final paycheck)
    category        TEXT NOT NULL,
    is_active       BOOLEAN NOT NULL DEFAULT TRUE,
    notes           TEXT
);

CREATE TABLE transactions (
    id              SERIAL PRIMARY KEY,
    account_id      INT NOT NULL REFERENCES accounts(id),
    txn_date        DATE NOT NULL,
    amount          NUMERIC(12,2) NOT NULL,     -- signed: negative = money out
    description     TEXT NOT NULL,
    category_id     INT REFERENCES categories(id),   -- set by auto-coding (rules first, Claude fallback)
    source          TEXT NOT NULL DEFAULT 'manual' CHECK (source IN ('manual', 'make', 'seed', 'reconciliation')),
    recurring_item_id INT REFERENCES recurring_items(id),  -- set when matched to a projected item
    external_ref    TEXT,                       -- bank reference / Make.com dedupe key
    created_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
    UNIQUE (account_id, external_ref)
);

CREATE INDEX idx_txn_account_date ON transactions (account_id, txn_date);
CREATE INDEX idx_recurring_active ON recurring_items (is_active) WHERE is_active;

