// Finance Agent projection engine
// Pure logic: takes accounts + recurring items, returns day-by-day balances.
// No database dependency here; the app layer feeds it rows from Postgres.

// ---- date helpers (all work in UTC date-only space) ----
function d(iso) { return new Date(iso + 'T00:00:00Z'); }
function iso(date) { return date.toISOString().slice(0, 10); }
function addDays(date, n) { const x = new Date(date); x.setUTCDate(x.getUTCDate() + n); return x; }
function daysBetween(a, b) { return Math.round((b - a) / 86400000); }

// Does a recurring item occur on this date?
function occursOn(item, date) {
  const day = date.getUTCDay();          // 0=Sunday
  const dom = date.getUTCDate();
  if (item.start_date && date < d(item.start_date)) return false;
  if (item.end_date && date > d(item.end_date)) return false;
  if (item.is_active === false) return false;

  switch (item.frequency) {
    case 'once':
      return item.anchor_date && iso(date) === item.anchor_date;
    case 'weekdays':
      return day >= 1 && day <= 5;
    case 'weekly': {
      if (item.anchor_date) {
        const diff = daysBetween(d(item.anchor_date), date);
        return diff >= 0 && diff % 7 === 0;
      }
      return item.weekday !== null && item.weekday !== undefined && day === item.weekday;
    }
    case 'biweekly': {
      if (!item.anchor_date) return false;
      const diff = daysBetween(d(item.anchor_date), date);
      return diff >= 0 && diff % 14 === 0;
    }
    case 'semimonthly':
      return dom === 1 || dom === 15;
    case 'monthly': {
      const target = item.day_of_month ??
        (item.anchor_date ? d(item.anchor_date).getUTCDate() : null);
      if (target === null) return false;
      if (item.anchor_date && date < d(item.anchor_date)) return false;
      // clamp: day 31 fires on last day of shorter months
      const lastDom = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth() + 1, 0)).getUTCDate();
      return dom === Math.min(target, lastDom);
    }
    case 'quarterly': {
      if (!item.anchor_date) return false;
      const a = d(item.anchor_date);
      if (date < a) return false;
      const monthsApart = (date.getUTCFullYear() - a.getUTCFullYear()) * 12 + (date.getUTCMonth() - a.getUTCMonth());
      return monthsApart % 3 === 0 && dom === a.getUTCDate();
    }
    default:
      return false;
  }
}

/**
 * Project daily balances.
 * @param accounts   [{id, nickname, account_type, opening_balance, opening_date, is_active}]
 * @param items      recurring_items rows (see schema)
 * @param opts       {startDate, horizonDays}
 * @returns {days, accounts: {nickname: {daily: [{date, balance, events[]}], low, lowDate}}, flags[]}
 */
function project(accounts, items, opts = {}) {
  const horizon = opts.horizonDays ?? 45;
  const start = d(opts.startDate);
  const balances = {};
  const byId = {};
  const series = {};

  for (const a of accounts) {
    byId[a.id] = a;
    balances[a.id] = Number(a.opening_balance);
    series[a.nickname] = { daily: [], low: Infinity, lowDate: null, lowestBeforeInflow: null };
  }

  const flags = [];

  for (let i = 0; i < horizon; i++) {
    const date = addDays(start, i);
    const todays = {};   // account_id -> events

    for (const item of items) {
      if (!occursOn(item, date)) continue;
      let amt = Number(item.amount);
      // pay_full_balance: transfer whatever clears the target card's debt that day
      if (item.pay_full_balance && item.transfer_to_id) {
        amt = Math.max(0, -balances[item.transfer_to_id]);
        amt = Math.round(amt * 100) / 100;
      }
      if (amt === 0) continue;
      const push = (accId, delta, label) => {
        balances[accId] += delta;
        (todays[accId] = todays[accId] || []).push({ label, delta, estimate: !!item.amount_is_estimate });
      };
      if (item.direction === 'inflow') push(item.account_id, amt, item.name);
      else if (item.direction === 'outflow') push(item.account_id, -amt, item.name);
      else if (item.direction === 'transfer') {
        push(item.account_id, -amt, item.name + ' (out)');
        // credit card "transfer_to" reduces debt (balance rises toward 0)
        if (item.transfer_to_id) push(item.transfer_to_id, amt, item.name + ' (in)');
      }
    }

    for (const a of accounts) {
      const bal = Math.round(balances[a.id] * 100) / 100;
      const s = series[a.nickname];
      const events = todays[a.id] || [];
      s.daily.push({ date: iso(date), balance: bal, events });
      if (a.account_type !== 'credit') {
        if (bal < s.low) { s.low = bal; s.lowDate = iso(date); }
        if (bal < 0) flags.push({ date: iso(date), account: a.nickname, type: 'OVERDRAFT', balance: bal });
        else if (bal < 500 && a.nickname === 'Bills') flags.push({ date: iso(date), account: a.nickname, type: 'LOW_BALANCE', balance: bal });
      }
    }
  }

  // lowest point before next inflow, per account (from the report's perspective: today)
  for (const a of accounts) {
    if (a.account_type === 'credit') continue;
    const s = series[a.nickname];
    const firstInflowIdx = s.daily.findIndex(day => day.events.some(e => e.delta > 0));
    const scope = firstInflowIdx > 0 ? s.daily.slice(0, firstInflowIdx) : s.daily;
    const low = scope.reduce((m, day) => (day.balance < m.balance ? day : m), scope[0]);
    if (low) s.lowestBeforeInflow = { date: low.date, balance: low.balance };
  }

  return { start: iso(start), horizonDays: horizon, accounts: series, flags };
}

module.exports = { project, occursOn };

